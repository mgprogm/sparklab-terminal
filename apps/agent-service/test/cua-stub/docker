#!/usr/bin/env node
/**
 * Stub `docker` for the Virtual Computer end-to-end test. Emulates just the
 * four invocations ComputerRuntime makes:
 *
 *   docker run -d --rm --name <n> --label sparklab-cua=1 ... <image>
 *   docker exec -i <container> cua-driver mcp --direct
 *   docker rm -f <names...>
 *   docker ps -aq --filter label=sparklab-cua
 *
 * Every call's argv is appended (one JSON array per line) to $CUA_STUB_LOG so
 * the test can assert teardown and orphan-sweep happened.
 */
import { appendFileSync } from "node:fs";
import { spawnSync } from "node:child_process";
import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";

const argv = process.argv.slice(2);
const log = process.env.CUA_STUB_LOG;
if (log) {
  try {
    appendFileSync(log, JSON.stringify(argv) + "\n");
  } catch {
    // best effort
  }
}

const sub = argv[0];

if (sub === "run") {
  // A detached container id on stdout, like the real CLI.
  process.stdout.write("ctr_e2e_" + Date.now().toString(36) + "\n");
  process.exit(0);
}

if (sub === "exec") {
  // ... <container> cua-driver mcp --direct  -> hand our pipes to the stub MCP.
  const here = dirname(fileURLToPath(import.meta.url));
  const mcp = join(here, "cua-driver-mcp.mjs");
  const res = spawnSync(process.execPath, [mcp], { stdio: "inherit" });
  process.exit(res.status ?? 0);
}

if (sub === "rm") {
  process.exit(0);
}

if (sub === "ps") {
  // No orphan containers in the test environment.
  process.exit(0);
}

process.stderr.write(`stub docker: unhandled subcommand ${sub}\n`);
process.exit(1);
