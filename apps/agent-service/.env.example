# Azure OpenAI (AI Foundry) — copy to .env and fill in. .env is gitignored.
# Local run_codex calls reuse these values without storing another copy in the
# gateway env. Remote Codex hosts still require their own credentials.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<secret>
AZURE_OPENAI_API_VERSION=2025-04-01-preview
GPT56SOL_DEPLOYMENT=gpt-5.6-sol
# Optional Azure AI Foundry deployments. When configured, they appear in the
# Agent chat model picker; deployment names remain server-side.
# GPT56TERRA_DEPLOYMENT=gpt-5.6-terra
# GPT56LUNA_DEPLOYMENT=gpt-5.6-luna

# Optional BytePlus Ark provider — DeepSeek / GLM over an OpenAI-compatible REST
# endpoint (Bearer auth). Its models ("DeepSeek V4 Pro", "DeepSeek V3.2",
# "GLM-4.7") appear in the Agent chat model picker only when ARK_API_KEY is set.
# reasoning_effort is not sent for any of them; DeepSeek also gets thinking=disabled.
# Deployment ids are env-overridable — Ark uses dated suffixes and they vary per
# account; list yours with:  curl .../api/v3/models -H "Authorization: Bearer $KEY"
# ARK_API_KEY=<secret>
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com
# ARK_DEEPSEEK_DEPLOYMENT=deepseek-v4-pro-260425
# ARK_DEEPSEEK_V32_DEPLOYMENT=deepseek-v3-2-251201
# ARK_GLM_DEPLOYMENT=glm-4-7-251222

# Optional OpenRouter provider. One picker entry ("openrouter-gpt-latest")
# gates on the key below; OPENROUTER_MODEL is only its fixed default — the
# composer can also search OpenRouter's live catalog and target any model per
# turn (see docs/AGENT-PROTOCOL.md's "Dynamic model search" section). The key
# and optional attribution headers stay server-side.
# OPENROUTER_API_KEY=<secret>
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=~openai/gpt-latest
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_APP_TITLE=SparkLab Terminal
# OPENROUTER_CATALOG_TTL_MS=600000

# Optional "Codex CLI" model-picker entry. When enabled, choosing "Codex CLI" in
# the Agent chat routes each user turn to the Codex CLI (via the gateway's
# POST /api/sessions/:id/codex route), rooted at the SELECTED terminal's working
# directory, instead of a chat-completions model. Codex has its own agentic loop
# and tools; the agent-service tool set is not offered for these turns, and each
# turn is approved individually (like run_codex). Turns are independent — Codex
# does not see earlier chat messages. Codex credentials come from the gateway
# host's own environment (OPENAI_*/CODEX_* or `codex login`), not from here.
# CODEX_PROVIDER_ENABLED=true
# Sandbox policy every Codex turn runs under: "workspace-write" (default — edits
# confined to the terminal's cwd) or "read-only" (no file changes).
# CODEX_PROVIDER_MODE=workspace-write

# Agent service
AGENT_PORT=3009
AGENT_HOST=127.0.0.1
GATEWAY_URL=http://127.0.0.1:3007
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003
# Production rejects WebSockets without Origin. Use true only for loopback tools.
AGENT_ALLOW_MISSING_ORIGIN=true
MAX_AGENT_CONNECTIONS=32

# Credentials the service uses to log in to the gateway (match the gateway's).
GATEWAY_AUTH_USER=admin
GATEWAY_AUTH_PASSWORD=<gateway-password>

# Optional virtual browser. Browser tools are disabled when this is unset.
# Run `uv sync` and `uvx browser-use install` in this checkout first.
BROWSER_USE_PROJECT=/home/you/src/browser-use
BROWSER_USE_HEADLESS=true
# Optional: select a system-managed sandboxed Chromium explicitly.
BROWSER_USE_EXECUTABLE_PATH=/snap/bin/chromium

# Browser/handoff resource bounds.
MAX_BROWSER_SESSIONS=4
MAX_BROWSER_LAUNCHES=2
MAX_HANDOFF_CONNECTIONS=16
MAX_WEBRTC_PEERS=4

# Rollback-safe transport flag. `jpeg` is the production default. This revision
# contains signaling/receiver foundation but no WebRTC media provider, so
# `webrtc-preferred` falls back automatically until a provider is installed.
BROWSER_HANDOFF_TRANSPORT=jpeg
BROWSER_HANDOFF_WEBRTC_TIMEOUT_MS=8000

# Future media-provider ICE configuration. TURN uses coturn REST credentials
# generated per handoff; never configure static TURN user/password in client env.
# BROWSER_HANDOFF_STUN_URLS=stun:stun.example.com:3478
# BROWSER_HANDOFF_TURN_URLS=turns:turn.example.com:5349
# BROWSER_HANDOFF_TURN_SECRET=<server-only-coturn-rest-secret>
# BROWSER_HANDOFF_TURN_TTL_SECONDS=600

# Optional Virtual Computer (CUA). computer_observe / computer_act are offered
# to the model ONLY when CUA_ENABLED=true. See docs/VIRTUAL-COMPUTER.md, section
# "Enabling CUA for one operator", for the full runbook. Quick version:
#   docker build -t sparklab/cua-desktop:0.22.2 apps/agent-service/test/cua-real
#   docker network create --internal sparklab-cua-egress
# then set the five vars below (ENABLED / IMAGE / DRIVER_USER / EGRESS_NETWORK /
# PERMISSION_MODE). The stock trycua/xfce-cua:latest pins cua-driver 0.12.4,
# which has no `mcp --direct`, so the locally-built image is required.
# CUA_ENABLED=true
# CUA_IMAGE=sparklab/cua-desktop:0.22.2
# CUA_DOCKER_BIN=docker
# Isolated docker network for the desktop. STRONGLY RECOMMENDED — without it the
# desktop has an unrestricted route off-box and startup logs a WARNING (not a
# failure; offline dev needs the default bridge). `--internal` = no route
# off-box at all, so the desktop also cannot browse the web (the safe v1
# default). Create it once:  docker network create --internal sparklab-cua-egress
# CUA_EGRESS_NETWORK=sparklab-cua-egress
#
# --- M3.5 opt-in proxied browsing (WEAKER guarantee — read carefully) ---
# CUA_PROXY_BROWSING=true lets the desktop reach allowed public HTTP(S) through
# the agent-service SafeProxy (same public-only ruleset as Browser Use:
# loopback / link-local / private / cloud-metadata are refused). Firefox ESR is
# pointed at it via an enterprise policy written at container start; curl / wget
# via http_proxy env. This is NOT a containment boundary: with it on the
# container is NOT on an --internal network, so it keeps a default route off-box
# and anything that ignores the proxy env/policy (`curl --noproxy '*'`, a
# non-proxy-aware app) egresses freely. `--internal` (CUA_EGRESS_NETWORK) stays
# the ONLY mode with a hard zero-egress guarantee, and the two are mutually
# exclusive — setting both is a fatal config error.
# NOTE: end-to-end Firefox browsing through the proxy is UNVERIFIED on
# sparklab/cua-desktop:0.22.2 (Firefox 140 ESR cannot render pages in that
# image — broken software-GL framebuffer — unrelated to egress). curl/wget
# routing is verified.
# CUA_PROXY_BROWSING=false
# Where the per-runtime SafeProxy listens on the agent-service host. Default
# 0.0.0.0 so a container on the default bridge can reach it — but that is an
# open forward proxy on every interface. RECOMMENDED: the docker bridge gateway
# IP (172.17.0.1 for the default bridge), reachable from bridge containers but
# not off-box.
# CUA_PROXY_BIND_HOST=172.17.0.1
# The host the container dials to reach the proxy. Default host.docker.internal
# is auto-mapped to the bridge gateway via --add-host=...:host-gateway; an
# explicit IP is used as-is.
# CUA_PROXY_CONTAINER_HOST=host.docker.internal
#
# The desktop image runs XFCE as user `cua` on DISPLAY :1; the driver joins it.
# CUA_DRIVER_USER=cua
# CUA_DRIVER_HOME=/home/cua
# CUA_DISPLAY=:1
# CUA_DRIVER_CMD=cua-driver
# Default permission mode is `standard` (= allow). `bounded` admits ONLY the
# tools in the capability manifest and fails every other call closed. Under
# `bounded`, CUA_CAPABILITY_MANIFEST_FILE auto-defaults to the image-baked
# /etc/cua/capability-manifest.yaml (COPYed in by test/cua-real/Dockerfile) — no
# need to set it. computer-runtime.ts refuses to start `bounded` if the path is
# unresolved.
# CUA_DRIVER_PERMISSION_MODE=bounded
# CUA_CAPABILITY_MANIFEST_FILE=/etc/cua/capability-manifest.yaml
# Per-service concurrency caps (M2.2). Defaults shown.
# MAX_CUA_DESKTOPS=3
# MAX_CUA_LAUNCHES=1
# Instance id for the boot-time orphan sweep (M2.3). Empty = the host name.
# MUST be stable across restarts for a crashed process's leaked desktop to be
# reaped on the next start. Set explicitly if the host name is ephemeral
# (containerised agent-service) or you run more than one instance on a host.
# CUA_INSTANCE_ID=
# Opt-in container hardening (--cap-drop ALL --security-opt no-new-privileges).
# Off by default: untested against the XFCE image; can break a sudo/gosu entrypoint.
# CUA_HARDEN=true
# In-container path get_desktop_state writes screenshots to before the runtime
# pulls the bytes out; and the noVNC port polled for X-session readiness.
# CUA_SCREENSHOT_DIR=/tmp
# CUA_NOVNC_PORT=6901
# CUA_START_TIMEOUT_MS=90000
